---
import { Image } from "astro:assets";
import logoMascot from "@/assets/images/brand/logo-mascot.png";
import { session } from "@/config/session";

const year = new Date().getFullYear();
const { copy, social, session: info } = session;

const cierreParts = copy.cierre.split(":");
const cierreFirst = (cierreParts[0] ?? copy.cierre).trim();
const cierreLast = cierreParts.slice(1).join(":").trim();
---

<footer class="relative overflow-hidden bg-[#0A0A0A] text-white">
  <Image
    src={logoMascot}
    alt=""
    width={900}
    densities={[1, 2]}
    loading="lazy"
    decoding="async"
    aria-hidden="true"
    class="footer-mascot pointer-events-none absolute -right-24 -top-32 z-0 h-auto w-[420px] select-none opacity-25 mix-blend-screen sm:-right-12 sm:-top-20 sm:w-[560px] md:w-[640px]"
  />

  <div
    class="relative z-10 mx-auto flex max-w-[1400px] flex-col gap-16 px-6 py-20 sm:px-10 sm:py-28"
  >
    <div class="flex items-start justify-between gap-8">
      <Image
        src={logoMascot}
        alt="Voltaje Sessions"
        width={160}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="h-auto w-[120px] select-none sm:w-[160px]"
      />
      <a
        href={social.instagram}
        target="_blank"
        rel="noreferrer"
        class="font-display group inline-flex items-center gap-2 text-sm uppercase tracking-[0.4em] text-white/70 transition-colors duration-300 hover:text-[color:var(--color-accent)] sm:text-base"
      >
        <span
          class="transition-transform duration-300 group-hover:-translate-y-0.5"
          >Instagram</span
        >
        <span
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          ↗
        </span>
      </a>
    </div>

    <div class="relative">
      <p
        class="font-display max-w-5xl text-5xl uppercase leading-[0.9] text-white sm:text-7xl md:text-[9vw]"
      >
        {cierreFirst}{cierreLast ? ":" : ""}
        {
          cierreLast ? (
            <span class="block text-[color:var(--color-accent)]">
              {cierreLast}
            </span>
          ) : null
        }
      </p>

      <svg
        aria-hidden="true"
        viewBox="0 0 1200 16"
        preserveAspectRatio="none"
        class="footer-line mt-6 h-3 w-full text-[color:var(--color-accent)]"
      >
        <path
          d="M0,8 L40,8 L60,2 L80,14 L100,8 L320,8 L340,1 L360,15 L380,8 L600,8 L620,2 L640,14 L660,8 L880,8 L900,1 L920,15 L940,8 L1200,8"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          stroke-dasharray="8 6"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="0"
            to="-28"
            dur="1.4s"
            repeatCount="indefinite"
          ></animate>
        </path>
      </svg>
    </div>

    <div
      class="grid grid-cols-1 gap-10 border-t-2 border-white/10 pt-10 sm:grid-cols-2"
    >
      <div>
        <p
          class="text-xs uppercase tracking-[0.4em] text-[color:var(--color-accent)]"
        >
          Próxima sesión
        </p>
        <p class="font-display mt-2 text-2xl uppercase">
          {info.voltaje} · {info.fecha}
        </p>
        <p class="mt-1 text-sm normal-case text-white/60">
          {info.lugar} · {info.ciudad}
        </p>
      </div>
      <div class="sm:text-right">
        <p
          class="text-xs uppercase tracking-[0.4em] text-[color:var(--color-accent)]"
        >
          Crédito
        </p>
        <p class="font-display mt-2 text-2xl uppercase">© {year}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.3em] text-white/50">
          PASSTIX
        </p>
      </div>
    </div>
  </div>

  <style>
    .footer-mascot {
      animation: footer-mascot-float 12s ease-in-out infinite alternate;
    }
    @keyframes footer-mascot-float {
      from {
        transform: rotate(-4deg) translateY(0);
      }
      to {
        transform: rotate(2deg) translateY(-12px);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .footer-mascot {
        animation: none;
      }
      .footer-line animate {
        display: none;
      }
    }
  </style>
</footer>
