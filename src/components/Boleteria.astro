---
import type { BoleteriaCombo, BoleteriaTier } from "@/config/session";
import { session, formatCOP } from "@/config/session";

const { boleteria, session: info } = session;
const earlyTier = boleteria.tiers.find((t) => t.id === "early");
const earlyHora = earlyTier?.horaLimite ?? "";

const getTierTotalUsuario = (tier: BoleteriaTier): number =>
  tier.valorEntrada + tier.servicioPasstix;

const getComboTotalUsuario = (combo: BoleteriaCombo): number =>
  combo.valorEntradas + combo.servicioPasstix;

const tableHeadClass =
  "font-display border-b-2 border-white/20 px-4 py-3 text-left text-[10px] uppercase tracking-[0.28em] text-white/60 sm:px-5 sm:text-xs sm:tracking-[0.32em]";
const tableCellClass =
  "border-b border-white/10 px-4 py-4 text-sm text-white/90 sm:px-5 sm:text-base";
const tableCellNumClass = `${tableCellClass} text-right font-display tabular-nums tracking-tight`;
const tableCellTotalClass = `${tableCellNumClass} text-[color:var(--color-accent)] text-lg sm:text-xl`;
---

<section
  id="boleteria"
  class="relative overflow-hidden bg-[#0A0A0A] text-white"
  aria-labelledby="boleteria-title"
>
  <span
    aria-hidden="true"
    class="font-display pointer-events-none absolute -left-6 top-8 select-none text-[34vw] leading-[0.78] text-[color:var(--color-accent)]/[0.08] sm:-left-8 sm:text-[22vw] md:text-[16vw]"
  >
    $
  </span>

  <div
    class="relative z-10 mx-auto flex max-w-[1400px] flex-col gap-14 px-6 py-24 sm:px-10 sm:py-32"
  >
    <header class="flex flex-col gap-3">
      <p
        class="font-display text-sm uppercase tracking-[0.4em] text-[color:var(--color-accent)]"
      >
        /02 · Boletería
      </p>
      <h2
        id="boleteria-title"
        class="font-display text-5xl uppercase leading-[0.85] sm:text-7xl md:text-[8vw]"
      >
        Entradas
        <span class="block text-[color:var(--color-accent)]">{info.voltaje}</span>
      </h2>
      <p class="max-w-md text-sm uppercase tracking-[0.3em] text-white/60 sm:text-base">
        Preventa .com · Compra en voltajesessions.com
      </p>
    </header>

    <div class="flex flex-col gap-4">
      <p class="font-display text-xl uppercase leading-tight text-white sm:text-2xl">
        Valores
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-white/70 sm:text-base">
        El total que pagas es
        <span class="text-white">boleta + servicio PASSTIX</span>
        (entrada más comisión de plataforma).
      </p>

      <div class="-mx-6 overflow-x-auto px-6 sm:mx-0 sm:px-0">
        <table class="w-full min-w-[520px] border-collapse text-left">
          <caption class="sr-only">
            Precios por tipo de entrada: valor de la entrada, servicio PASSTIX y total.
          </caption>
          <thead>
            <tr>
              <th scope="col" class={tableHeadClass}>Entrada</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>Valor entrada</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>Servicio PASSTIX</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>
                Total usuario paga
              </th>
            </tr>
          </thead>
          <tbody>
            {
              boleteria.tiers.map((tier) => {
                const total = getTierTotalUsuario(tier);
                const rowHighlight =
                  tier.destacado === true
                    ? "bg-[color:var(--color-accent)]/[0.08]"
                    : "";
                return (
                  <tr class={`transition-colors duration-200 ${rowHighlight}`}>
                    <th scope="row" class={`${tableCellClass} font-display text-base uppercase sm:text-lg`}>
                      <span class="flex flex-col gap-1">
                        <span>{tier.nombre}</span>
                        {tier.destacado ? (
                          <span class="font-display w-fit border border-[color:var(--color-accent)] px-2 py-0.5 text-[9px] uppercase tracking-[0.28em] text-[color:var(--color-accent)]">
                            Recomendada
                          </span>
                        ) : null}
                      </span>
                    </th>
                    <td class={tableCellNumClass}>{formatCOP(tier.valorEntrada)}</td>
                    <td class={tableCellNumClass}>{formatCOP(tier.servicioPasstix)}</td>
                    <td class={tableCellTotalClass}>
                      <span class="flex flex-col items-end gap-0.5">
                        <span>{formatCOP(total)}</span>
                        <span class="font-sans text-[10px] font-normal normal-case tracking-normal text-white/45 sm:text-xs">
                          (boleta + servicio)
                        </span>
                      </span>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <ul
        role="list"
        class="grid grid-cols-1 gap-3 border-t border-white/10 pt-6 sm:grid-cols-3 sm:gap-4"
      >
        {
          boleteria.tiers.map((tier) => (
            <li class="text-sm leading-relaxed text-white/75">
              <p class="font-display text-xs uppercase tracking-[0.3em] text-white/50">
                {tier.nombre}
              </p>
              <p class="mt-1">{tier.descripcion}</p>
              {tier.condicion ? (
                <p class="mt-2 text-xs uppercase tracking-[0.22em] text-white/50">
                  {tier.condicion}
                  {tier.horaLimite ? ` · Hasta ${tier.horaLimite}` : ""}
                </p>
              ) : null}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <p class="font-display text-2xl uppercase leading-tight sm:text-3xl">
          Combos x4
          <span class="text-[color:var(--color-accent)]"> — pagan 3 y entran 4</span>
        </p>
        <p class="font-display text-xs uppercase tracking-[0.35em] text-white/50 sm:text-sm">
          /grupo
        </p>
      </div>

      <div class="-mx-6 overflow-x-auto px-6 sm:mx-0 sm:px-0">
        <table class="w-full min-w-[520px] border-collapse text-left">
          <caption class="sr-only">
            Precios de combos por cuatro entradas: valor de entradas, servicio PASSTIX y total.
          </caption>
          <thead>
            <tr>
              <th scope="col" class={tableHeadClass}>Combo</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>Valor entradas</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>Servicio PASSTIX</th>
              <th scope="col" class={`${tableHeadClass} text-right`}>
                Total usuario paga
              </th>
            </tr>
          </thead>
          <tbody>
            {
              boleteria.combos.map((combo) => {
                const total = getComboTotalUsuario(combo);
                return (
                  <tr class="transition-colors duration-200 hover:bg-white/[0.03]">
                    <th scope="row" class={`${tableCellClass} font-display text-base uppercase sm:text-lg`}>
                      <span class="flex flex-col gap-1">
                        <span>{combo.nombre}</span>
                        <span class="font-sans text-[10px] font-normal normal-case tracking-normal text-white/45 sm:text-xs">
                          {combo.cantidad} entradas · pagan {combo.pagan}
                        </span>
                      </span>
                    </th>
                    <td class={tableCellNumClass}>{formatCOP(combo.valorEntradas)}</td>
                    <td class={tableCellNumClass}>{formatCOP(combo.servicioPasstix)}</td>
                    <td class={tableCellTotalClass}>
                      <span class="flex flex-col items-end gap-0.5">
                        <span>{formatCOP(total)}</span>
                        <span class="font-sans text-[10px] font-normal normal-case tracking-normal text-white/45 sm:text-xs">
                          (boleta + servicio)
                        </span>
                      </span>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t-2 border-white/10 pt-8">
      <ul role="list" class="flex flex-col gap-2 text-xs uppercase tracking-[0.3em] text-white/55 sm:text-sm">
        <li>{boleteria.comboNota}</li>
        <li>
          Early Entrance: {boleteria.earlyNota}
          {earlyHora ? ` (límite ${earlyHora})` : ""}
        </li>
      </ul>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={boleteria.ctaPrimario.url}
          target="_blank"
          rel="noreferrer"
          class="font-display group inline-flex w-full items-center justify-center gap-3 border-4 border-white bg-[color:var(--color-cta)] px-6 py-4 text-lg uppercase text-[color:var(--color-cta-text)] shadow-[6px_6px_0_0_var(--color-accent)] transition-shadow duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[color:var(--color-accent)] hover:shadow-[10px_10px_0_0_var(--color-accent)] sm:w-auto sm:px-8 sm:text-xl"
        >
          <span class="transition-transform duration-300 group-hover:-translate-x-1">
            {boleteria.ctaPrimario.texto}
          </span>
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-2">→</span>
        </a>
        <a
          href={boleteria.ctaSecundario.url}
          class="font-display inline-flex w-full items-center justify-center gap-2 border-2 border-white/30 px-6 py-4 text-sm uppercase tracking-[0.3em] text-white transition-colors duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] sm:w-auto"
        >
          {boleteria.ctaSecundario.texto}
        </a>
      </div>
    </div>
  </div>
</section>
