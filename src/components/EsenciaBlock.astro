---
import { EsenciaText } from "@/components/EsenciaText";
import { session } from "@/config/session";

const { copy } = session;
---

<section
  class="relative overflow-hidden bg-[color:var(--color-bg)] py-28 sm:py-40"
>
  <p
    class="font-display absolute left-6 top-10 text-sm uppercase tracking-[0.4em] text-[color:var(--color-accent)] sm:left-10"
  >
    /03 · Esencia
  </p>

  <div class="mx-auto max-w-[1400px] px-6 sm:px-10">
    <EsenciaText client:load frases={copy.frases} />
  </div>

  <span
    aria-hidden
    class="font-display pointer-events-none absolute -right-4 -bottom-12 select-none text-[40vw] leading-none text-[color:var(--color-accent)]/15 sm:text-[30vw]"
  >
    /
  </span>
</section>
